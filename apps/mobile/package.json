{
  "name": "@bizzi/mobile",
  "version": "0.0.1",
  "private": true,
  "description": "bizzi phone app: Capacitor shell around packages/ui (client only)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.ts",
    "build:ui": "npm run build -w @bizzi/ui",
    "stage": "node scripts/stage.ts",
    "sync": "cap sync",
    "build": "npm run build:ui && npm run stage && npm run sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "run:ios": "cap run ios",
    "run:android": "cap run android",
    "build:ios:sim": "xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/DerivedData CODE_SIGNING_ALLOWED=NO build",
    "check:ios": "node scripts/check-ios.ts",
    "build:android": "cd android && ./gradlew assembleDebug",
    "icons": "node scripts/icons.ts"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/push-notifications": "^8.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "esbuild": "^0.28.2"
  }
}
