# Copy to deploy/.env and adjust. docker compose reads it automatically.

# Image tag for bizzi/node and bizzi/hub.
BIZZI_TAG=latest

# Public URL of the hub, as reached through your reverse proxy (used for pairing links and push clicks).
BIZZI_PUBLIC_URL=https://bizzi.example.com

# Where the node dials the hub. On the hub machine: the internal network.
# On agent-only machines: wss://bizzi.example.com/ws/node
BIZZI_HUB_URL=ws://hub:7777/ws/node

# One-time node pairing code (README "First run", step 4). Only read while the node has no
# /data/hub-credential.json; you can delete the line once the node is paired.
BIZZI_PAIR_CODE=

# Name shown in the machine list.
BIZZI_MACHINE_NAME=server-a

# Optional: token for direct access to the node's own endpoint (bypassing the hub).
# Empty = random; normally every client goes through the hub. Generate one: openssl rand -hex 32
BIZZI_TOKEN=

# Optional push notifications through ntfy (approvals, questions, long turns finishing).
# Use a hard-to-guess topic, or your own ntfy server with an access token.
BIZZI_NTFY_URL=
BIZZI_NTFY_TOKEN=

# Web Push to browsers is on by default (each device opts in under Settings → Devices).
# Contact for the push services (mailto: or https:); Safari rejects placeholders. 0 turns Web Push off.
BIZZI_VAPID_SUBJECT=
BIZZI_WEBPUSH=

# Run agents as your host user (id -u / id -g), so files in the workspaces dir stay yours.
PUID=1000
PGID=1000

# Host directory with your workspaces, mounted at /workspaces in the node container.
BIZZI_WORKSPACES=/srv/bizzi/workspaces

# External Docker network your reverse proxy (SWAG, Caddy) is on.
BIZZI_PROXY_NETWORK=proxy

# Container workspaces (topology.md §7), with `docker compose --profile containers up -d`: the node
# drives the dind sidecar's Docker daemon, never the host's socket.
BIZZI_DOCKER_HOST=
# BIZZI_DOCKER_HOST=tcp://dind:2376
# Image for container workspaces without a devcontainer.json (default bizzi/workspace:latest, built
# from packages/containers/image into dind on first use).
BIZZI_CONTAINER_IMAGE=
# Agent logins inside containers come from the node's secrets store or its environment (README).

TZ=UTC
